# URL do backend Spring Boot (branch dev: ./mvnw spring-boot:run na raiz do repo)
# Sem esta variável o front roda em modo Sandbox (tudo local, sem backend).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Supabase Auth (login Google). O backend só aceita o JWT emitido pelo Supabase.
# Dashboard Supabase > Project Settings > API: URL e "publishable key".
NEXT_PUBLIC_SUPABASE_URL=https://ktksibdcggnpcyxgmfvf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUIR

# Opcional (só modo Sandbox): Client ID do Google para o popup do GIS sem backend
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
