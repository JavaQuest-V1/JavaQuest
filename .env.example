# Copie este arquivo para .env (ignorado pelo Git) e preencha os segredos reais
# Direct connection (IPv6) ou Session Pooler Supavisor (IPv4: aws-0-us-east-2.pooler.supabase.com:5432)
JAVAQUEST_DB_URL=jdbc:postgresql://db.ktksibdcggnpcyxgmfvf.supabase.co:5432/postgres?sslmode=require&prepareThreshold=0
JAVAQUEST_DB_USERNAME=javaquest_app
JAVAQUEST_DB_PASSWORD=SUBSTITUIR_PELA_SENHA_DA_ROLE_JAVAQUEST_APP

# Configuracao JWT do Supabase Auth (Google OAuth 2.0 exclusivo)
JAVAQUEST_SUPABASE_ISSUER_URI=https://ktksibdcggnpcyxgmfvf.supabase.co/auth/v1
JAVAQUEST_SUPABASE_JWKS_URI=https://ktksibdcggnpcyxgmfvf.supabase.co/auth/v1/.well-known/jwks.json

# Origens permitidas no CORS (separadas por virgula)
JAVAQUEST_CORS_ORIGINS=http://localhost:3000
